# Environment Mode: development | production
ENVIRONMENT=development

# Database Connection (SQLite default; switch to PostgreSQL URL in production)
DATABASE_URL=sqlite:///./gdg_rit.db

# JWT Secret Key (REQUIRED in production - use a strong 64+ character random string)
SECRET_KEY=replace-with-a-strong-random-secret-key

# Allowed CORS Origins (comma-separated, never use * with credentials)
CORS_ORIGINS=http://localhost:5173,https://gdg-rit-website.vercel.app

# Initial Administrator Account Provisioning
ADMIN_USERNAME=admin
ADMIN_EMAIL=gdgoncampusgdgclubrit@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FULL_NAME=GDG RIT Administrator

# Development-only flag to sync admin credentials on startup
RESET_ADMIN_ON_STARTUP=false
