# GDG on Campus - RIT Hassan Environment Configuration Template
# Copy relevant variables into backend/.env and frontend/.env for local or production setups.
# NEVER commit real .env files or production credentials to GitHub.

# ==========================================
# BACKEND (FastAPI -> backend/.env)
# ==========================================
ENVIRONMENT=development
DATABASE_URL=sqlite:///./gdg_rit.db
SECRET_KEY=replace-with-a-strong-random-64-char-secret
CORS_ORIGINS=http://localhost:5173,https://gdg-rit-website.vercel.app

# Initial Administrator Account (Required in production; dev defaults exist locally)
ADMIN_USERNAME=admin
ADMIN_EMAIL=gdgoncampusgdgclubrit@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FULL_NAME=GDG RIT Administrator

# Optional (Development ONLY): Set to true to sync admin credentials on backend startup
RESET_ADMIN_ON_STARTUP=false

# ==========================================
# FRONTEND (React + Vite -> frontend/.env)
# ==========================================
VITE_API_BASE_URL=http://localhost:8000/api
VITE_BACKEND_URL=http://localhost:8000
